{
  "name": "Multi Camera",
  "description": "Profile for synchronized multi-camera setup",
  "camera_settings": {
    "sync": true,
    "master_index": 0,
    "exposure": "auto",
    "fps": 30,
    "resolution": "1080p"
  },
  "preprocessing_settings": {
    "resize": {
      "width": 1280,
      "height": 720
    },
    "denoise": true,
    "normalize": true,
    "alignment": "feature_based"
  },
  "format_settings": {
    "output_format": "tiff",
    "compression": "none"
  },
  "storage_settings": {
    "buffer_size": 50,
    "storage_mode": "file",
    "naming_pattern": "cam%camera_index%_%timestamp%",
    "group_by_capture": true
  }
}