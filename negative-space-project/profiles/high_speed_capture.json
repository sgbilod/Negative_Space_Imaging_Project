{
  "name": "High Speed Capture",
  "description": "Profile for high-speed image acquisition",
  "camera_settings": {
    "exposure": "auto",
    "fps": 120,
    "resolution": "720p",
    "format": "MJPG"
  },
  "preprocessing_settings": {
    "resize": {
      "width": 640,
      "height": 360
    },
    "denoise": false,
    "normalize": true
  },
  "format_settings": {
    "output_format": "jpg",
    "quality": 80,
    "compression": "high"
  },
  "storage_settings": {
    "buffer_size": 100,
    "storage_mode": "temp_file",
    "naming_pattern": "hs_%timestamp%_%index%"
  }
}