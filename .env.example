# ============================================================================
# NEGATIVE SPACE IMAGING PROJECT - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update values for your environment
# IMPORTANT: Never commit .env file to version control
# ============================================================================

# ============================================================================
# ENVIRONMENT TYPE
# ============================================================================
NODE_ENV=development
ENVIRONMENT=development

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
LOG_LEVEL=info

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
# For production, use DATABASE_URL with connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/negative_space_imaging
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
# CRITICAL: Change this password in production
DB_PASSWORD=postgres
DB_NAME=negative_space_imaging
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
# DB_SSL: Set to true in production for encrypted connections
DB_SSL=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD: Set a strong password in production
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_MEMORY=256mb
REDIS_TIMEOUT=5000
REDIS_ENABLED=true
REDIS_RECONNECT_DELAY=1000
REDIS_MAX_RETRIES=10
# REDIS_URL: Alternative connection string format
REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT AUTHENTICATION (REQUIRED FOR PRODUCTION)
# ============================================================================
# CRITICAL: JWT_SECRET must be set to a unique, cryptographically secure random string
# Generate with: openssl rand -hex 32 (or use a secure password generator)
# This value has no default - the application will fail to start without it
JWT_SECRET=<REQUIRED: generate-a-secure-random-string-min-64-chars>
JWT_EXPIRES_IN=24h
JWT_ALGORITHM=HS256
JWT_REFRESH_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookie secret for session management (required in production)
# Generate with: openssl rand -hex 32
COOKIE_SECRET=<REQUIRED-IN-PRODUCTION: generate-a-secure-random-string>

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# CRITICAL: In production, specify exact allowed origins (no wildcards)
# Multiple origins can be comma-separated
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ============================================================================
# RATE LIMITING (AUTH ENDPOINTS)
# ============================================================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_ADMIN=true
RATE_LIMIT_MESSAGE=Too many requests, please try again later
# Auth-specific rate limiting (stricter for login/register endpoints)
AUTH_RATE_LIMIT_WINDOW=300000
AUTH_RATE_LIMIT_MAX=10
# Maximum failed login attempts before temporary lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
# Lockout duration in milliseconds (15 minutes)
ACCOUNT_LOCKOUT_DURATION=900000

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug
REQUEST_LOGGING=true
ERROR_SHOW_STACK=true
LOG_DIR=logs
LOG_FILE_MAX_SIZE=5242880
LOG_MAX_FILES=10
LOG_FORMAT=combined

# ============================================================================
# SECURITY (PRODUCTION RECOMMENDATIONS)
# ============================================================================
# BCRYPT_ROUNDS: Higher values are more secure but slower (12+ recommended for production)
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
SESSION_TIMEOUT=60
# ENABLE_HTTPS_ONLY: Set to true in production
ENABLE_HTTPS_ONLY=false
ENABLE_SECURITY_HEADERS=true
# ENABLE_HSTS: Set to true in production for HTTPS enforcement
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000

# Encryption keys (REQUIRED FOR PRODUCTION)
# Generate with: openssl rand -hex 32 (for ENCRYPTION_KEY)
# Generate with: openssl rand -hex 8 (for ENCRYPTION_IV)
ENCRYPTION_KEY=<REQUIRED: 64-hex-character-encryption-key>
ENCRYPTION_IV=<REQUIRED: 16-hex-character-initialization-vector>

# ============================================================================
# APPLICATION FEATURES
# ============================================================================
ENABLE_IMAGE_PROCESSING=true
ENABLE_CACHE=true
CACHE_TTL=3600
MAX_IMAGE_SIZE=100
ALLOWED_FORMATS=jpg,jpeg,png,webp,tiff,bmp

# ============================================================================
# HEALTH CHECK
# ============================================================================
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30
HEALTH_DETAILED_METRICS=true

# ============================================================================
# EXTERNAL SERVICES (API KEYS - NEVER COMMIT REAL VALUES)
# ============================================================================
# Replace placeholder values with actual API keys in your local .env
CLAUDE_API_KEY=<your-claude-api-key>
OPENAI_API_KEY=<your-openai-api-key>
IMAGE_PROCESSING_API_KEY=<your-image-processing-api-key>

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
ENABLE_REQUEST_TRACING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_METRICS=true
METRICS_INTERVAL=60

# ============================================================================
# DEPLOYMENT
# ============================================================================
DEPLOYMENT_ENV=local
APP_VERSION=1.0.0
BUILD_TIMESTAMP=

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
DEBUG=false
DEV_SKIP_RATE_LIMIT=false
DEV_SEED_DATABASE=false

# HIPAA Compliance Configuration
HIPAA_ENABLED=true
DATA_ENCRYPTION=true
AUDIT_LOG_ENABLED=true
AUTO_LOGOUT=900000
